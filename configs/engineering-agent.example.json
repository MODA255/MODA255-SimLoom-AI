{
  "generate_scripts": true,
  "llm": {
    "enabled": false,
    "model": "gpt-4o-mini",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 60
  },
  "windows": {
    "catia_prog_id": "CATIA.Application",
    "ansys_prog_id": "Ansys.Application",
    "adams_prog_id": "Adams.View",
    "vi_grade_prog_id": "VIgrade.Application"
  },
  "windows_bridge": {
    "root_dir": "C:/EngineeringAgent/projects",
    "host": "127.0.0.1",
    "port": 8099,
    "token": "change-me",
    "timeout_seconds": 1800,
    "commands": {
      "catia.create_or_update_model": ["CNEXT", "-macro", "{script}"],
      "ansys.mesh_and_solve": ["runwb2.exe", "-B", "-R", "{script}"],
      "adams.build_and_run_multibody": ["adams", "-c", "{script}"],
      "vi-grade.run_vehicle_dynamics": ["vi-grade-runner.exe", "{script}"]
    },
    "com": {
      "CATIA.Application": {"methods": ["StartCommand", "Quit"]}
    }
  },
  "timeouts": {
    "step_seconds": 600
  },
  "environment": {},
  "tools": {
    "ansys": {
      "executable": "ansyswb",
      "bridge_url": ""
    },
    "catia": {
      "executable": "CNEXT",
      "bridge_url": ""
    },
    "adams": {
      "executable": "adams",
      "bridge_url": ""
    },
    "vi-grade": {
      "executable": "",
      "bridge_url": ""
    }
  }
}
