      "material_selection": {
        "source_types": ["douyin_video", "douyin_live", "weibo_video"],
        "main_assets": {"selection": "content_rich_material_for_theme_discovery", "min": 1},
        "opening_assets": {"selection": "not_used_by_default", "required": false},
        "bgm": {"selection": "controlled_by_feature_profile"}
      },
      "fixed_feature_config": {
        "recipe": "auto_theme_discovery",
        "use_default_matrixgen_template": true,
        "num_versions": 1,
        "brief": "",
        "enable_subtitle": true,
        "enable_fancy_text": false,
        "bgm_mode": "none",
        "force_portrait": false,
        "enable_dynamic_crop": false,
        "delivery_enabled": false
      },
      "acceptance_profile": "manual_auto_theme_standard"
    },
