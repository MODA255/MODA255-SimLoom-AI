{
  "template_set_id": "matrixgen-daily-scene-templates-v1",
  "version": "1.0",
  "status": "draft",
  "purpose": "仅定义每日剪辑场景模板，不包含执行结果、具体候选素材或远程任务 ID。",
  "global_rules": {
    "allowed_sources": ["douyin_video", "douyin_live", "weibo_video"],
    "delivery_enabled": false,
    "advertiser": null,
    "awemes": [],
    "promotion_goal": null,
    "adlab_scene": null,
    "business_entity_policy": "从远程固定集合中匹配，不允许 AI 编造实体 ID",
    "dynamic_input_policy": "品牌、商品、IP、机制、标题、主题、brief、素材和 BGM 由 Agent 按业务事实动态生成或匹配",
    "fixed_feature_policy": "功能开关、recipe、版本数、投放和验收规则由模板固定，不由 Agent 随机修改"
  },
  "templates": [
    {
      "template_id": "manual-ecom-default-v1",
      "name": "后台手动电商混剪-默认基线",
      "chain_type": "manual",
      "scene_type": "ecom",
      "purpose": "验证真实电商素材、业务语义和默认电商混剪链路",
      "dynamic_business_input": {
        "brand_name": {"source": "fixed_collection", "required": true},
        "product_name": {"source": "brand_product_collection", "required": true},
        "ip_name": {"source": "matched_collection_or_null", "required": false},
        "mechanism": {"source": "material_fact_or_fixed_collection", "required": false},
        "project_name": {"source": "agent_generated", "required": true},
        "topic": {"source": "agent_generated_from_material_facts", "required": true},
        "brief": {"source": "agent_generated_from_material_facts", "required": false},
        "content_angle": {"source": "agent_generated", "required": true}
      },
      "material_selection": {
        "source_types": ["douyin_video", "weibo_video"],
        "main_assets": {"selection": "match_business_input_and_material_facts", "min": 1},
        "opening_assets": {"selection": "optional_from_main_assets", "required": false},
        "bgm": {"selection": "controlled_by_feature_profile"}
      },
      "fixed_feature_config": {
        "recipe": "ecom_remix",
        "use_default_matrixgen_template": true,
        "num_versions": 1,
        "enable_subtitle": true,
        "enable_fancy_text": false,
        "bgm_mode": "none",
        "enable_smart_native_insertion": false,
        "enable_sfx": false,
        "force_portrait": false,
        "enable_dynamic_crop": false,
        "delivery_enabled": false
      },
      "acceptance_profile": "manual_vfc_standard"
    },
    {
      "template_id": "manual-auto-theme-default-v1",
      "name": "后台手动自动主题发现-空需求",
      "chain_type": "manual",
      "scene_type": "auto_theme_discovery",
      "purpose": "验证素材进入自动主题发现后由系统自主发现主题并完成出片",
      "dynamic_business_input": {
        "brand_name": {"source": "matched_collection_or_null", "required": false},
