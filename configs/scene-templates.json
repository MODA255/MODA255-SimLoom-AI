        "mechanism": {"source": "material_fact_or_null", "required": false},
        "project_name": {"source": "agent_generated", "required": true},
        "topic": {"source": "post_material_observation", "required": false},
        "brief": {"source": "fixed_empty", "value": "", "required": true},
        "content_angle": {"source": "post_material_observation", "required": false}
